---
import BaseLayout from './BaseLayout.astro';
import InteractiveBackdrop from '../components/InteractiveBackdrop.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <InteractiveBackdrop />
  <slot />
</BaseLayout>
