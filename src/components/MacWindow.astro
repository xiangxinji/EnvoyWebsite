---
interface Props {
  title?: string;
}

const { title = 'Envoy workspace' } = Astro.props;
---

<div class="mac-window">
  <div class="title-bar">
    <div class="traffic-lights" aria-hidden="true">
      <span class="light"></span>
      <span class="light"></span>
      <span class="light"></span>
    </div>
    <span class="title">{title}</span>
    <div class="title-status">live</div>
  </div>
  <div class="window-body">
    <slot />
  </div>
</div>

<style>
  .mac-window {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, var(--surface-2), var(--surface-1));
    box-shadow: var(--shadow-soft);
  }

  .title-bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.035);
  }

  .traffic-lights {
    display: flex;
    flex-shrink: 0;
    gap: 6px;
  }

  .light {
    width: 10px;
    height: 10px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
  }

  .title {
    flex: 1;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
  }

  .title-status {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .title-status::before {
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 16px rgba(94, 224, 156, 0.7);
    content: "";
  }

  .window-body {
    min-height: 320px;
  }

  @media (max-width: 640px) {
    .title-status {
      display: none;
    }
  }
</style>
