---
---

<div class="interactive-backdrop" id="interactive-backdrop" aria-hidden="true">
  <canvas id="backdrop-particles"></canvas>
  <div class="refraction-field"></div>
  <div class="scan-field"></div>
</div>

<style>
  .interactive-backdrop {
    --mx: 72vw;
    --my: 24vh;
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: transparent;
  }

  .interactive-backdrop::before {
    position: absolute;
    inset: -12%;
    content: "";
    opacity: 0.34;
    background:
      linear-gradient(115deg, transparent 0 34%, rgba(148, 242, 191, 0.09) 35%, transparent 38% 100%),
      linear-gradient(72deg, transparent 0 52%, rgba(255, 255, 255, 0.065) 53%, transparent 56% 100%);
    filter: blur(0.4px);
    transform: translate3d(calc((var(--mx) - 50vw) * -0.018), calc((var(--my) - 50vh) * -0.012), 0);
    transition: transform 0.18s ease-out;
    mask-image: linear-gradient(to bottom, transparent, black 14%, black 72%, transparent);
  }

  .interactive-backdrop::after {
    position: absolute;
    inset: 0;
    content: "";
    opacity: 0.62;
    background: radial-gradient(18rem 13rem at var(--mx) var(--my), rgba(148, 242, 191, 0.2), rgba(94, 224, 156, 0.07) 34%, transparent 72%);
    filter: blur(16px) saturate(122%);
    mix-blend-mode: screen;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.5;
  }

  .refraction-field {
    position: absolute;
    inset: 0;
    opacity: 0.24;
    background-image:
      linear-gradient(90deg, rgba(255, 255, 255, 0.085) 1px, transparent 1px),
      linear-gradient(rgba(255, 255, 255, 0.065) 1px, transparent 1px);
    background-position:
      calc(var(--mx) * -0.04) calc(var(--my) * -0.03),
      calc(var(--mx) * 0.03) calc(var(--my) * 0.02);
    background-size: 5.5rem 5.5rem;
    mask-image: radial-gradient(44rem 34rem at var(--mx) var(--my), black, transparent 72%);
  }

  .scan-field {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background: repeating-linear-gradient(0deg, transparent 0 13px, rgba(255, 255, 255, 0.045) 14px, transparent 15px);
    background-size: 100% 100%;
    background-position: 0 0;
    mask-image: linear-gradient(to bottom, transparent, black 20%, black 76%, transparent);
  }

  @media (max-width: 760px) {
    canvas {
      opacity: 0.28;
    }

    .refraction-field {
      background-size: 4.25rem 4.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .interactive-backdrop::before {
      transform: none;
      transition: none;
    }

    canvas {
      display: none;
    }
  }
</style>

<script>
  const globalWindow = window;
  const previousCleanup = globalWindow.__envoyBackdropCleanup;
  if (typeof previousCleanup === 'function') previousCleanup();

  const root = document.getElementById('interactive-backdrop');
  const canvas = document.getElementById('backdrop-particles');
  const ctx = canvas instanceof HTMLCanvasElement ? canvas.getContext('2d') : null;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  let width = 0;
  let height = 0;
  let frame = 0;
  let raf = 0;
  let pointerX = window.innerWidth * 0.72;
  let pointerY = window.innerHeight * 0.24;
  let targetX = pointerX;
  let targetY = pointerY;
  let particles = [];

  function paintPointer(x, y) {
    root?.style.setProperty('--mx', `${x}px`);
    root?.style.setProperty('--my', `${y}px`);
  }

  function resize() {
    if (!canvas || !ctx) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = Math.floor(width * dpr);
    canvas.height = Math.floor(height * dpr);
    canvas.style.width = `${width}px`;
    canvas.style.height = `${height}px`;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const count = Math.min(110, Math.max(42, Math.floor(width / 18)));
    particles = Array.from({ length: count }, (_, index) => ({
      x: (index * 97) % width,
      y: (index * 53) % height,
      vx: ((index % 7) - 3) * 0.045,
      vy: (((index + 3) % 9) - 4) * 0.035,
      r: index % 5 === 0 ? 1.45 : 0.9,
    }));
  }

  function draw() {
    if (!ctx || reducedMotion.matches) return;
    frame += 1;
    pointerX += (targetX - pointerX) * 0.085;
    pointerY += (targetY - pointerY) * 0.085;
    paintPointer(pointerX, pointerY);
    ctx.clearRect(0, 0, width, height);

    for (let i = 0; i < particles.length; i += 1) {
      const p = particles[i];
      const dx = pointerX - p.x;
      const dy = pointerY - p.y;
      const distance = Math.max(80, Math.sqrt(dx * dx + dy * dy));
      const pull = Math.min(0.018, 1 / (distance * 280));

      p.vx += dx * pull;
      p.vy += dy * pull;
      p.vx *= 0.992;
      p.vy *= 0.992;
      p.x += p.vx + Math.sin((frame + i * 17) * 0.006) * 0.05;
      p.y += p.vy + Math.cos((frame + i * 13) * 0.005) * 0.04;

      if (p.x < -24) p.x = width + 24;
      if (p.x > width + 24) p.x = -24;
      if (p.y < -24) p.y = height + 24;
      if (p.y > height + 24) p.y = -24;

      const glow = Math.max(0, 1 - distance / 520);
      ctx.beginPath();
      ctx.fillStyle = `rgba(148, 242, 191, ${0.18 + glow * 0.46})`;
      ctx.arc(p.x, p.y, p.r + glow * 1.4, 0, Math.PI * 2);
      ctx.fill();
    }

    for (let i = 0; i < particles.length; i += 1) {
      for (let j = i + 1; j < particles.length; j += 1) {
        const a = particles[i];
        const b = particles[j];
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const distance = Math.sqrt(dx * dx + dy * dy);
        if (distance > 118) continue;
        ctx.beginPath();
        ctx.strokeStyle = `rgba(148, 242, 191, ${(1 - distance / 118) * 0.08})`;
        ctx.lineWidth = 1;
        ctx.moveTo(a.x, a.y);
        ctx.lineTo(b.x, b.y);
        ctx.stroke();
      }
    }

    raf = window.requestAnimationFrame(draw);
  }

  function onPointerMove(event) {
    targetX = event.clientX;
    targetY = event.clientY;
    if (reducedMotion.matches) {
      pointerX = targetX;
      pointerY = targetY;
      paintPointer(pointerX, pointerY);
    }
  }

  paintPointer(pointerX, pointerY);
  resize();
  if (!reducedMotion.matches) draw();

  window.addEventListener('resize', resize, { passive: true });
  window.addEventListener('pointermove', onPointerMove, { passive: true });

  globalWindow.__envoyBackdropCleanup = () => {
    window.cancelAnimationFrame(raf);
    window.removeEventListener('resize', resize);
    window.removeEventListener('pointermove', onPointerMove);
  };
</script>
