---
import { getLangFromUrl, useTranslations, path } from '../i18n/utils';

const locale = getLangFromUrl(Astro.url);
const t = useTranslations(locale);
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="logo-icon">◆</span>
      <span class="logo-text">Envoy</span>
      <p>{t('footer.description')}</p>
    </div>
    <div class="footer-links">
      <div class="footer-col">
        <h4>{t('footer.product')}</h4>
        <a href={path(locale === 'en' ? '/en/features' : '/features')}>{t('nav.features')}</a>
        <a href={path(locale === 'en' ? '/en/download' : '/download')}>{t('nav.download')}</a>
      </div>
      <div class="footer-col">
        <h4>{t('footer.resources')}</h4>
        <a href={path(locale === 'en' ? '/en/getting-started' : '/getting-started')}>{t('nav.docs')}</a>
      </div>
      <div class="footer-col">
        <h4>{t('footer.community')}</h4>
        <a href="https://github.com/xiangxinji/EnvoyClient">GitHub</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} Envoy. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
    padding: var(--space-2xl) var(--space-xl) var(--space-lg);
    margin-top: 80px;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: var(--space-2xl);
    justify-content: space-between;
  }

  .footer-brand {
    max-width: 280px;
  }

  .footer-brand .logo-icon {
    color: var(--accent);
    font-size: 20px;
  }

  .footer-brand .logo-text {
    font-weight: 600;
    font-size: 18px;
    color: var(--text-primary);
  }

  .footer-brand p {
    margin-top: var(--space-sm);
    color: var(--text-secondary);
    font-size: 13px;
    line-height: 1.5;
  }

  .footer-links {
    display: flex;
    gap: var(--space-2xl);
  }

  .footer-col h4 {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-sm);
  }

  .footer-col a {
    display: block;
    color: var(--text-secondary);
    font-size: 13px;
    padding: 3px 0;
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    max-width: 1200px;
    margin: var(--space-xl) auto 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }

  .footer-bottom p {
    color: var(--text-muted);
    font-size: 12px;
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      gap: var(--space-xl);
    }
  }
</style>
