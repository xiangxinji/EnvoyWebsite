<div class="orb-background">
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
  <div class="orb orb-3"></div>
  <div class="orb orb-4"></div>
</div>

<style>
  .orb-background {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: -1;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.6;
  }

  .orb-1 {
    width: 400px;
    height: 400px;
    background: var(--orb-1);
    top: -100px;
    right: 10%;
  }

  .orb-2 {
    width: 300px;
    height: 300px;
    background: var(--orb-2);
    top: 40%;
    left: -80px;
  }

  .orb-3 {
    width: 250px;
    height: 250px;
    background: var(--orb-3);
    bottom: 10%;
    right: 20%;
  }

  .orb-4 {
    width: 200px;
    height: 200px;
    background: var(--orb-4);
    bottom: 30%;
    left: 30%;
  }

  @media (max-width: 768px) {
    .orb-1 { width: 250px; height: 250px; }
    .orb-2 { width: 180px; height: 180px; }
    .orb-3 { width: 150px; height: 150px; }
    .orb-4 { width: 120px; height: 120px; }
  }
</style>
