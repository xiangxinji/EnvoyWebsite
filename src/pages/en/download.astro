---
import LandingLayout from '../../layouts/LandingLayout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('en');
---

<LandingLayout title="Download — Envoy">
  <section class="download-page">
    <h1 class="page-title">{t('download.title')}</h1>
    <p class="page-subtitle">{t('download.subtitle')}</p>
    <div class="download-grid">
      <div class="download-card">
        <div class="platform-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
        </div>
        <h3>{t('download.macos')}</h3>
        <p class="req">{t('download.macosReq')}</p>
        <a href="#" class="btn-primary">{t('download.comingSoon')}</a>
      </div>
      <div class="download-card">
        <div class="platform-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 12V6.75l6-1.32v6.48L3 12zm17-9v8.75l-10 .08V5.21L20 3zM3 13l6 .09v6.81l-6-1.15V13zm17 .25V22l-10-1.91V13.1l10 .15z"/>
          </svg>
        </div>
        <h3>{t('download.windows')}</h3>
        <p class="req">{t('download.windowsReq')}</p>
        <a href="#" class="btn-primary">{t('download.comingSoon')}</a>
      </div>
    </div>
  </section>
</LandingLayout>

<style>
  .download-page { max-width: 800px; margin: 0 auto; padding: 100px var(--space-xl) 60px; text-align: center; }
  .page-title { font-size: 36px; font-weight: 700; color: var(--text-primary); margin-bottom: var(--space-sm); }
  .page-subtitle { font-size: 16px; color: var(--text-secondary); margin-bottom: var(--space-2xl); }
  .download-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-xl); }
  .download-card {
    padding: var(--space-2xl);
    background: var(--glass-bg-light); border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl); backdrop-filter: blur(var(--glass-blur));
    display: flex; flex-direction: column; align-items: center; gap: var(--space-md);
  }
  .platform-icon { color: var(--text-primary); }
  .download-card h3 { font-size: 20px; font-weight: 600; color: var(--text-primary); }
  .req { font-size: 13px; color: var(--text-secondary); }
  .btn-primary {
    padding: 10px 24px; background: var(--accent); color: var(--text-on-accent);
    border-radius: var(--radius-md); font-size: 14px; font-weight: 600;
    text-decoration: none; transition: background 0.2s; margin-top: var(--space-sm);
  }
  .btn-primary:hover { background: var(--accent-hover); color: var(--text-on-accent); }
  @media (max-width: 768px) { .download-grid { grid-template-columns: 1fr; } .page-title { font-size: 28px; } }
</style>
